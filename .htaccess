# Zakaliya Shared Blessings Ministry: zakaliyasbm-mn.com (static site)

# Friendly "page not found" page
ErrorDocument 404 /pages/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use https://zakaliyasbm-mn.com (no www). Written without %{...} placeholders,
  # because GoDaddy Managed WordPress doesn't fill them in. (GoDaddy already sends http:// to https://.)
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^/?(.*)$ https://zakaliyasbm-mn.com/$1 [L,R=301]

  # Old WordPress addresses -> the new clean addresses (keeps old links and search results working).
  # The pages themselves (/about, /projects, /projects/farming, ...) are served by
  # wp-content/mu-plugins/zakaliya-static.php from the /pages folder.
  RewriteRule ^home/?$ / [L,R=301]
  RewriteRule ^(about-2|about-us)/?$ /about [L,R=301]
  RewriteRule ^(contact-3|join-us)/?$ /contact [L,R=301]
  RewriteRule ^(projects01|services)/?$ /projects [L,R=301]
  RewriteRule ^donation-confirmation/?$ /thank-you [L,R=301]
  RewriteRule ^(donations|donations/.*|donation-failed)/?$ /donate [L,R=301]
  RewriteRule ^(blog|blog-post-title|my-account|my-cart|checkout|shop|donor-dashboard|terms|privacy)/?$ / [L,R=301]
</IfModule>

# Keep the deploy tool's bookkeeping file private
<Files ".ftp-deploy-sync-state.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# Browser caching
# Pages, styles and scripts: browsers check for a newer version on every visit,
# so changes show up right after a deploy (unchanged files still load from cache via a quick check).
# Images and fonts: kept for 1 day to keep the site fast.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Basic security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
