---
permalink: /pages/editor.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#18322a">
  <meta name="robots" content="noindex, nofollow">
  <title>Website editor - {{ site.name }}</title>
  <link rel="icon" type="image/png" href="{{ site.logo }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/admin/editor.css?v={{ build.id }}">
</head>
<body>
  {#- The editor app (assets/admin/editor.js) draws everything inside #app.
      Signing in is handled by WordPress (wp-content/mu-plugins/zakaliya-editor.php). #}
  <div id="app" class="zk-boot" aria-live="polite">
    <div class="zk-boot-card">
      <img src="{{ site.logo }}" alt="" width="96" height="58">
      <p class="zk-boot-title">{{ site.name }}</p>
      <p class="zk-boot-text" id="zk-boot-text">Opening the website editor&hellip;</p>
    </div>
  </div>
  <noscript><p class="zk-noscript">The website editor needs JavaScript. Please turn it on in your browser.</p></noscript>
  <script>window.ZK_EDITOR = {{ { "supabaseUrl": editorConfig.supabaseUrl, "supabaseKey": editorConfig.supabaseKey, "logo": site.logo, "siteName": site.name } | json | safe }};</script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
  <script src="/assets/admin/js-yaml.min.js?v=4.3.2"></script>
  <script src="/assets/admin/editor.js?v={{ build.id }}"></script>
  {#- Same freshness check as the website pages (GoDaddy makes browsers keep pages for 31 days) #}
  <script>(function(b){try{if(!window.fetch||!window.sessionStorage)return;fetch("/build-id.txt?v="+Date.now(),{cache:"no-store"}).then(function(r){return r.ok?r.text():""}).then(function(t){t=String(t).trim();if(!/^[\w-]{6,80}$/.test(t)||t===b)return;var k="zk-fresh-"+t+location.pathname;if(sessionStorage.getItem(k))return;sessionStorage.setItem(k,"1");var go=function(){location.reload()};fetch(location.href,{cache:"reload",credentials:"same-origin"}).then(go,go)}).catch(function(){})}catch(e){}})({{ build.id | json | safe }});</script>
</body>
</html>
