---
layout: base.njk
pagination:
  data: detailProjects
  size: 1
  alias: pr
permalink: "/pages/projects/{{ pr.slug }}.html"
navKey: projects
extraCss: ["/assets/project-detail.css?v=1"]
scriptsAfter: ["/assets/project-detail.js?v=1"]
eleventyComputed:
  canonical: "/projects/{{ pr.slug }}"
---
{%- from "macros.njk" import img, thumb -%}
{%- set others = [] -%}
{%- for o in projects | where("category", "ongoing") %}{% if o.detail_page and o.slug != pr.slug %}{% set others = others.concat([o]) %}{% endif %}{% endfor -%}
    <section class="pd-hero" aria-labelledby="pd-title">
      <div class="wrap pd-hero-inner">
        <div class="pd-hero-copy">
          <p class="pd-crumbs"><a href="/projects">Projects</a><span aria-hidden="true">/</span><a href="/projects#{{ 'ongoing-projects' if pr.category == 'ongoing' else 'completed-projects' }}">{{ 'Ongoing' if pr.category == 'ongoing' else 'Completed' }}</a><span aria-hidden="true">/</span>{{ pr.title }}</p>
          <p class="pd-status"><span aria-hidden="true"></span>{{ pr.status_label }}</p>
          <h1 id="pd-title">{{ pr.title }}</h1>
          <p class="pd-lead">{{ pr.lead or pr.card_text }}</p>
          <div class="hero-actions"><a class="button" href="/donate">Support this project</a><a class="text-link" href="#{{ 'progress' if pr.updates.length else 'gallery' }}">{{ 'See the progress' if pr.updates.length else 'See the photos' }} <span aria-hidden="true">&darr;</span></a></div>
        </div>
{%- if pr.image %}
        <figure class="pd-hero-media"><a href="{{ pr.image }}" data-lightbox aria-label="View photo full screen">{{ img(pr.image, pr.image_alt, "img-focus-top" if pr.image_focus_top else "", "", true) }}</a></figure>
{%- endif %}
      </div>
    </section>
{%- if pr.facts.length %}
    <section class="pd-facts" aria-label="Project facts"><div class="wrap"><dl>{% for f in pr.facts %}<div><dt>{{ f.label }}</dt><dd>{{ f.value }}</dd></div>{% endfor %}</dl></div></section>
{%- endif %}
{%- if pr.about %}
    <section class="intro pd-about" aria-labelledby="about-title">
      <div class="wrap intro-grid" data-reveal>
        <div><p class="section-kicker">{{ pr.about_kicker or "About the project" }}</p><h2 id="about-title">{{ pr.about_title }}</h2></div>
        <div class="intro-copy">
          {{ pr.about | md | safe }}
        </div>
      </div>
    </section>
{%- endif %}
{%- if pr.updates.length %}
    <section class="pd-section" id="progress" aria-labelledby="progress-title">
      <div class="wrap">
        <div class="pd-section-head" data-reveal><div><p class="section-kicker">Progress</p><h2 id="progress-title">How the work is going</h2></div><p>Updates are listed newest first. Tap any photo to see it larger.</p></div>
        <ol class="pd-timeline">
{%- for u in pr.updates %}
          <li class="pd-update{% if loop.first %} is-latest{% endif %}" data-reveal>
            <div class="pd-update-copy"><p class="pd-update-stage">{{ u.stage }}</p><h3>{{ u.title }}</h3>{% if u.date %}<time class="pd-date" datetime="{{ u.date | isoDate }}">{{ u.date | dateLong }}</time>{% elif u.date_note %}<span class="pd-date">{{ u.date_note }}</span>{% endif %}<p>{{ u.text }}</p></div>
            <div class="pd-update-photos">{% for ph in u.photos or [] %}{% if ph.image %}{{ thumb(ph) }}{% endif %}{% endfor %}</div>
          </li>
{%- endfor %}
        </ol>
      </div>
    </section>
{%- endif %}
{%- if pr.gallery.length %}
    <section class="pd-section" id="gallery" aria-labelledby="gallery-title">
      <div class="wrap">
        <div class="pd-section-head" data-reveal><div><p class="section-kicker">Gallery</p><h2 id="gallery-title">Photos from the project</h2></div><p>{{ pr.gallery.length }} photo{{ "" if pr.gallery.length == 1 else "s" }}. Tap a photo to view it full screen.</p></div>
        <ul class="pd-gallery" data-reveal>
{%- for ph in pr.gallery %}{% if ph.image %}
          <li>{{ thumb(ph) }}</li>
{%- endif %}{% endfor %}
        </ul>
        <p class="pd-gallery-note">More photos will be added as the project progresses.</p>
      </div>
    </section>
{%- endif %}
    <section class="invitation" aria-labelledby="help-title">
      <div class="wrap invitation-inner"><div><p class="section-kicker">How you can help</p><h2 id="help-title">{{ pr.help_title or "Help this project grow." }}</h2><p>{{ pr.help_text }}</p></div><a class="button button-dark" href="/donate">Donate</a></div>
    </section>
{%- if others.length %}
    <section class="pd-others" aria-labelledby="others-title">
      <div class="wrap">
        <div class="pd-section-head"><div><p class="section-kicker">Keep exploring</p><h2 id="others-title">Other ongoing projects</h2></div><a class="text-link" href="/projects" style="color:var(--forest)">All projects <span aria-hidden="true" style="color:var(--forest)">&rarr;</span></a></div>
        <div class="pd-others-grid">
{%- for o in others | batch(3) | first %}
          <a class="pd-other" href="{{ o.url }}">{{ img(o.image, "", "img-focus-top" if o.image_focus_top else "") }}<div><p>{{ o.status_label }}</p><h3>{{ o.title }} <span aria-hidden="true">&rarr;</span></h3></div></a>
{%- endfor %}
        </div>
      </div>
    </section>
{%- endif %}
