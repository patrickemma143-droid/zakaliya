---
layout: base.njk
permalink: /projects.html
navKey: projects
pageKey: projects
canonical: /projects.html
extraCss: ["/assets/project-detail.css?v=1"]
scriptsAfter: ["/assets/project-gallery.js?v=1"]
---
{%- from "macros.njk" import img, hl -%}
{%- set p = pages.projects -%}
{%- set completed = projects | where("category", "completed") -%}
{%- set ongoing = projects | where("category", "ongoing") -%}
    <section class="page-hero projects-hero" aria-labelledby="page-title">{% if p.hero.image %}<div class="projects-hero-image">{{ img(p.hero.image, p.hero.image_alt, "", "", true) }}</div>{% endif %}<div class="wrap page-hero-inner"><div class="page-hero-copy"><p class="section-kicker">{{ p.hero.kicker }}</p><h1 id="page-title">{{ hl(p.hero.title, p.hero.title_highlight) }}</h1><p>{{ p.hero.text }}</p><a class="button" href="/contact.html">{{ p.hero.button_label }}</a></div></div></section>
    <nav class="project-index" aria-label="Project sections"><div class="wrap">{% if completed.length %}<a href="#completed-projects">{{ p.completed.index_label }} <span>{{ completed.length | pad2 }}</span></a>{% endif %}{% if ongoing.length %}<a href="#ongoing-projects">{{ p.ongoing.index_label }} <span>{{ ongoing.length | pad2 }}</span></a>{% endif %}</div></nav>
{%- if completed.length %}
    <section class="project-status-section completed-projects" id="completed-projects" aria-labelledby="completed-title">
      <div class="wrap">
        <header class="project-section-heading"><h2 id="completed-title">{{ p.completed.title }}</h2><p>{{ p.completed.text }}</p></header>
        <div class="project-story-list">
{%- for pr in completed %}
          <article class="pj-project-row pj-horizontal" id="{{ pr.slug }}">
            <figure class="pj-project-media project-fit-frame">{{ img(pr.image, pr.image_alt, "project-fit-image") }}</figure>
            <div class="pj-project-copy"><p class="project-status"><span aria-hidden="true"></span>{{ pr.status_label }}</p><h3>{{ pr.title }}</h3>{{ pr.summary | md | safe }}{% if pr.detail_page %}<a class="pj-detail-link" href="{{ pr.url }}">{{ p.ongoing.details_label }} <span aria-hidden="true">&rarr;</span></a>{% endif %}</div>
          </article>
{%- endfor %}
        </div>
      </div>
    </section>
{%- endif %}
{%- if ongoing.length %}
    <section class="project-status-section ongoing-projects" id="ongoing-projects" aria-labelledby="ongoing-title">
      <div class="wrap">
        <header class="project-section-heading"><h2 id="ongoing-title">{{ p.ongoing.title }}</h2><p>{{ p.ongoing.text }}</p></header>
        <div class="project-story-list">
{%- for pr in ongoing %}
          <article class="pj-project-row pj-horizontal" id="{{ pr.slug }}">
{%- set slides = (pr | slidePhotos) if pr.slideshow else [] %}
{%- if slides.length > 1 %}
            <div class="pj-project-media pj-progress-gallery" data-progress-gallery role="region" aria-roledescription="carousel" aria-label="{{ pr.title }} progress slideshow">
              <div class="pj-slides">
{%- for s in slides %}
                <figure class="pj-slide{% if loop.first %} is-active{% endif %}" data-gallery-slide role="group" aria-roledescription="slide" aria-label="Photo {{ loop.index }} of {{ slides.length }}"{% if not loop.first %} hidden{% endif %}>
                  {{ img(s.ph.image, s.ph.alt) }}
                  <figcaption><span class="pj-slide-stage">{{ s.u.stage }}</span><span>{{ s.u.title }}</span>{% if s.u.date %}<time datetime="{{ s.u.date | isoDate }}">{{ s.u.date | dateLong }}</time>{% else %}<time>{{ s.u.date_note }}</time>{% endif %}</figcaption>
                </figure>
{%- endfor %}
              </div>
              <div class="pj-gallery-controls">
                <p class="pj-gallery-count" data-gallery-status aria-live="polite">Photo 1 of {{ slides.length }}</p>
                <div class="pj-gallery-buttons">
                  <button class="pj-gallery-toggle" type="button" data-gallery-toggle aria-label="Pause slideshow">Pause</button>
                  <button type="button" data-gallery-prev aria-label="Previous photo">Previous</button>
                  <button type="button" data-gallery-next aria-label="Next photo">Next</button>
                </div>
              </div>
            </div>
{%- else %}
            <figure class="pj-project-media">{{ img(pr.image, pr.image_alt, "img-focus-top" if pr.image_focus_top else "") }}</figure>
{%- endif %}
            <div class="pj-project-copy"><p class="project-status"><span aria-hidden="true"></span>{{ pr.status_label }}</p><h3>{{ pr.title }}</h3>{{ pr.summary | md | safe }}{% if pr.detail_page %}<a class="pj-detail-link" href="{{ pr.url }}">{{ p.ongoing.details_label }} <span aria-hidden="true">&rarr;</span></a>{% endif %}</div>
          </article>
{%- endfor %}
        </div>
      </div>
    </section>
{%- endif %}
    <section class="invitation" id="contact" aria-labelledby="invitation-title"><div class="wrap invitation-inner"><div><p class="section-kicker">{{ p.invitation.kicker }}</p><h2 id="invitation-title">{{ p.invitation.title }}</h2><p>{{ p.invitation.text }}</p></div><a class="button button-dark" href="/donate.html">{{ p.invitation.button_label }}</a></div></section>
