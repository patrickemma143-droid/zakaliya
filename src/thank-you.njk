---
layout: base.njk
permalink: /thank-you.html
pageKey: thank_you
noindex: true
extraCss: ["/assets/donate.css?v=1"]
---
{%- from "macros.njk" import hl -%}
{%- set p = pages.thank_you -%}
    <section class="ty" aria-labelledby="ty-title">
      <div class="wrap ty-inner">
        <div class="don-hero-copy">
          <h1 id="ty-title">{{ hl(p.title, p.title_highlight) }}</h1>
          {{ p.body | md | safe }}
          <div class="hero-actions"><a class="button" href="/projects.html">{{ p.button_label }}</a><a class="text-link" href="/contact.html">{{ p.link_label }} <span aria-hidden="true">&rarr;</span></a></div>
        </div>
      </div>
    </section>
