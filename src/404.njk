---
layout: base.njk
permalink: /404.html
pageKey: not_found
noindex: true
extraCss: ["/assets/donate.css?v=1"]
---
{%- from "macros.njk" import hl -%}
{%- set p = pages.not_found -%}
    <section class="ty" aria-labelledby="nf-title">
      <div class="wrap ty-inner">
        <div class="don-hero-copy">
          <h1 id="nf-title">{{ hl(p.title, p.title_highlight) }}</h1>
          <p>{{ p.text }}</p>
          <div class="hero-actions"><a class="button" href="/">{{ p.button_label }}</a><a class="text-link" href="/projects.html">{{ p.link_label }} <span aria-hidden="true">&rarr;</span></a></div>
        </div>
      </div>
    </section>
